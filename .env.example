# Copia este archivo como .env y ajusta los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=zisa_reservaciones
DB_USER=postgres
DB_PASSWORD=tu-clave-de-postgres
DB_HOST=localhost
DB_PORT=5432

# Zona horaria del negocio
TIME_ZONE=America/Lima

# Clave para el formulario de reservas de zisa.pe. La misma va en wp-config.php
# como ZISA_RESERVAS_TOKEN. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_RESERVATION_TOKEN=

# Clave del cron externo que llama a /api/tareas/no-shows/ cada cinco minutos.
# Vacia = esa ruta desactivada. Generala igual que la anterior.
CRON_TOKEN=

# Solo en produccion (Render + Neon): si esta definida, reemplaza a DB_*.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/base?sslmode=require
