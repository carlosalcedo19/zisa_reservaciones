# Copia este archivo como .env y ajusta los valores.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=zisa_reservaciones
DB_USER=postgres
DB_PASSWORD=tu-clave-de-postgres
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=America/Lima

# Igual a ZISA_RESERVAS_TOKEN en wp-config.php.
WEB_RESERVATION_TOKEN=

# Token de /api/tareas/no-shows/. Vacio = ruta desactivada.
CRON_TOKEN=

# Si esta definida, reemplaza a DB_*.
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/base?sslmode=require

# Con BREVO_API_KEY se envia por Brevo y se ignora EMAIL_HOST.
# Sin ninguno de los dos, los correos solo se escriben en la consola.
BREVO_API_KEY=
# URL publica del logo; vacia = adjunto en linea (no sirve con Brevo).
EMAIL_LOGO_URL=
EMAIL_HOST=xxxx
EMAIL_PORT=xxxxx
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=xxxxx
EMAIL_HOST_PASSWORD=xxxxxxxxxx
DEFAULT_FROM_EMAIL=xxxxxxx
